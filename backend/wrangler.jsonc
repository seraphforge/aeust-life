{
  "$schema": "./tooling/node_modules/wrangler/config-schema.json",
  "name": "aeust-life-api-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "vars": {
    "ENVIRONMENT": "local",
    "ALLOWED_ORIGINS": "http://localhost:4321,http://127.0.0.1:4321"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "aeust-life-local",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "../database/migrations"
  }],
  "ratelimits": [
    { "name": "FEEDBACK_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "GLOBAL_LIMITER", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }
  ]
}
