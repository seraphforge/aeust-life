---
import { clubs, clubCategories, clubsIndexUrl, clubsReviewedAt } from '../data/clubs';
---
<section class="shell page-intro clubs-intro">
  <a class="breadcrumb" href={`${import.meta.env.BASE_URL}explore/`}>← 回到探索</a>
  <p class="eyebrow">02 / FIND YOUR PEOPLE <span class="version">V1</span></p>
  <h1>大學三大必修，<br />你修了幾個？</h1>
  <p class="intro-description">社團、打工、愛情，這三個缺一不可。那就來完成你的大學必修吧！</p>
  <div class="clubs-note"><span aria-hidden="true">◈</span><div><strong>先從一個有點心動的社團開始。</strong><p>找一起練習、一起創作、一起服務的夥伴。從你想體驗的事，找到課表之外的可能。</p></div></div>
</section>
<section class="shell section compact" data-club-guide aria-labelledby="club-list-title">
  <div class="section-heading"><div><p class="eyebrow">YOUR NEXT CHAPTER</p><h2 id="club-list-title">你的同類，可能就在這裡。</h2></div><p>{clubs.length} 個社團與自治組織<br />四大分類，還有其他社團等你探索。</p></div>
  <form class="club-filters" aria-label="搜尋與篩選社團" hidden>
    <label>想體驗什麼？<input type="search" name="keyword" placeholder="搜尋社團、特色或活動，例如：攝影" autocomplete="off" /></label>
    <label>社團分類<select name="category"><option value="">全部分類</option>{clubCategories.map(category => <option value={category}>{category}</option>)}</select></label>
    <button class="button" type="reset">清除條件</button>
  </form>
  <noscript><p class="small-note">目前顯示全部社團；啟用 JavaScript 即可使用搜尋與分類篩選。</p></noscript>
  <p class="results" role="status" aria-live="polite" aria-atomic="true" data-club-count>共 {clubs.length} 個社團與自治組織</p>
  <div class="club-grid">
    {clubs.map((club, index) => <article class="club-card" data-club data-category={club.displayCategory} data-search={[club.name, club.displayCategory, club.category, club.feature, ...club.activities].join(' ')}>
      <div class="club-card-top"><span class="category-label">{club.displayCategory}</span><span class="mono" aria-hidden="true">{String(index + 1).padStart(2, '0')} ↗</span></div>
      <h3>{club.name}</h3>
      {club.verificationNotes.length > 0 && <p class="source-note">部分資料待確認 · 請展開詳情查看</p>}
      <h4>加入後，可以體驗什麼？</h4><p class="feature">{club.feature}</p>
      {club.featureSource === 'project' && <p class="source-note">特色文字由專案提供，官方文字佐證待補充。</p>}
      <details class="club-details"><summary>展開活動與社團詳情<span class="sr-only">：{club.name}</span></summary>
        <p class="official-category">官方原始分類：{club.category}</p>
        {club.verificationNotes.length > 0 && <div class="verification"><h4>資料核對備註</h4><ul>{club.verificationNotes.map(note => <li>{note}</li>)}</ul></div>}
        <div class="club-activities"><h4>可體驗活動（依官方介紹）</h4>{club.activities.length > 0 ? <ul>{club.activities.map(activity => <li>{activity}</li>)}</ul> : <p class="pending">活動資料待補充</p>}</div>
        <p class="pending">本學期活動、招生與社課時間待確認；活動與社團現況請以官方最新公告為準。</p>
      </details>
      <div class="club-sources"><a class="text-link" href={club.sourceUrl} aria-label={`${club.name}官方介紹`}>官方介紹 ↗</a><a href={club.categorySourceUrl} aria-label={`${club.name}的官方分類來源`}>分類來源 ↗</a></div>
    </article>)}
  </div>
  <div class="empty-state" data-club-empty hidden><h3>還沒找到符合條件的社團。</h3><p>試試其他關鍵字、切換分類，或按「清除條件」查看全部。</p></div>
  <aside class="source-summary" aria-labelledby="club-source-title"><h2 id="club-source-title">有來源，才有介紹。</h2><p>名單與官方原始分類依<a class="text-link" href={clubsIndexUrl}>課外活動組社團分類介紹 ↗</a>及各社團介紹頁整理，核對日期：<time datetime={clubsReviewedAt}>{clubsReviewedAt}</time>。特色以學生語氣摘要改寫；缺少可核對文字的欄位標示待補充，無人機社特色另註明由專案提供。</p><p>系學會、運動性、服務性、技術性為本站方便探索所整理的分類，其他項目保留於「其他社團」；官方原始分類可在詳情中查看。技術性收錄實作、研究與應用方向的社團，並非官方分類名稱。</p><p>活動為官方曾列出的內容，不代表本學期正在舉辦；招生、時間與社團現況請以官方最新公告為準。</p></aside>
</section>

<script>
  const guide = document.querySelector<HTMLElement>('[data-club-guide]');
  if (guide) {
    const form = guide.querySelector<HTMLFormElement>('form')!;
    const keyword = form.querySelector<HTMLInputElement>('[name="keyword"]')!;
    const category = form.querySelector<HTMLSelectElement>('[name="category"]')!;
    const cards = [...guide.querySelectorAll<HTMLElement>('[data-club]')];
    const count = guide.querySelector<HTMLElement>('[data-club-count]')!;
    const empty = guide.querySelector<HTMLElement>('[data-club-empty]')!;
    const normalize = (value: string) => value.normalize('NFKC').toLocaleLowerCase();
    const update = () => {
      const terms = normalize(keyword.value).trim().split(/\s+/).filter(Boolean);
      let visible = 0;
      cards.forEach(card => {
        const text = normalize(card.dataset.search ?? '');
        card.hidden = !((!category.value || card.dataset.category === category.value) && terms.every(term => text.includes(term)));
        if (!card.hidden) visible++;
      });
      count.textContent = `共 ${visible} 個社團與自治組織`;
      empty.hidden = visible !== 0;
    };
    form.addEventListener('submit', event => event.preventDefault());
    keyword.addEventListener('input', update);
    category.addEventListener('change', update);
    form.addEventListener('reset', () => {
      keyword.value = '';
      category.value = '';
      update();
    });
    form.hidden = false;
    update();
  }
</script>

<style>
  [hidden] { display: none !important; }
  .clubs-intro h1 { max-width: 900px; }
  .clubs-note { display: flex; align-items: center; gap: 24px; margin-top: 32px; padding: 24px; border: 1px solid var(--color-ink); border-radius: 10px; background: var(--color-lime); }
  .clubs-note > span { font-size: 3rem; line-height: 1; }
  .clubs-note strong { font-size: 1.15rem; } .clubs-note p { margin-top: 8px; }
  .club-filters { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) auto; gap: 16px; align-items: end; }
  label { display: grid; gap: 8px; font-weight: 700; min-width: 0; }
  input, select { width: 100%; min-width: 0; min-height: 48px; border: 1px solid var(--color-ink); border-radius: 5px; padding: 12px; background: #fffdf7; color: var(--color-ink); font: inherit; }
  .club-filters button { background: transparent; }
  .results { margin-block: 24px 18px; color: var(--color-muted); font-size: .9rem; }
  .club-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  .club-card { display: flex; flex-direction: column; min-width: 0; padding: 24px; border: 1.5px solid var(--color-ink); border-radius: 8px; background: #fbfaf6; }
  .club-card-top { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px; }
  .category-label { font-size: .75rem; padding: 4px 10px; border-radius: 20px; background: var(--color-lime); }
  h3 { font-size: 1.4rem; margin-block: 22px; overflow-wrap: anywhere; }
  h4 { font-size: .8rem; margin: 0 0 8px; color: var(--color-muted); }
  .feature { font-size: .95rem; } .source-note, .pending { font-size: .8rem; color: var(--color-muted); }
  .source-note { margin-top: 12px; padding-left: 12px; border-left: 3px solid var(--color-accent); }
  .club-activities { margin-block: 24px; }
  .club-details { margin-block: 24px; }
  summary { cursor: pointer; font-weight: 700; padding-block: 10px; }
  summary:hover { color: #ad351e; }
  .official-category { margin-top: 12px; font-size: .8rem; color: var(--color-muted); }
  .verification { margin-top: 18px; padding: 14px; border-left: 3px solid var(--color-accent); background: #fff4e9; }
  .verification ul { display: grid; gap: 10px; } .verification li { border: 0; padding: 0; }
  ul { display: flex; flex-wrap: wrap; gap: 8px; margin: 0; padding: 0; list-style: none; }
  li { font-size: .75rem; border: 1px solid var(--color-line); border-radius: 4px; padding: 4px 8px; }
  .club-sources { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 16px; margin-top: auto; padding-top: 18px; border-top: 1px solid var(--color-line); }
  .club-sources > a:last-child { font-size: .8rem; text-decoration: underline; text-underline-offset: 4px; }
  .source-summary { margin-top: 48px; padding: 28px; border: 1px solid var(--color-line); border-radius: 10px; }
  .source-summary h2 { font-size: 1.4rem; margin-bottom: 16px; } .source-summary p + p { margin-top: 12px; }
  .source-summary p { font-size: .85rem; color: var(--color-muted); }
  @media (max-width: 960px) { .club-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .club-filters { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); } .club-filters label:first-child { grid-column: 1 / -1; } }
  @media (max-width: 640px) { .club-grid, .club-filters { grid-template-columns: 1fr; } .clubs-note { padding: 20px; } .clubs-note > span { display: none; } .club-card, .source-summary { padding: 22px; } }
</style>
