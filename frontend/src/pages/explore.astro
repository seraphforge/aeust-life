---
import Layout from '../layouts/Layout.astro';
import TopicCard from '../components/TopicCard.astro';
import { topics } from '../data/topics';
---
<Layout title="探索生活"><section class="shell page-intro"><p class="eyebrow">THE CAMPUS IS YOUR PLAYGROUND</p><h1>給好奇心，<br />留一個下午。</h1><p class="intro-description">不用先有計畫。從一個有點心動的主題開始，<br />看看課表之外，還有哪些可能。</p><span class="status-pill planned">V0.1 · 功能規劃介紹</span></section><section class="shell section compact"><h2 class="sr-only">探索主題</h2><div class="topic-grid explore-grid">{topics.map(topic => <TopicCard topic={topic} />)}</div><div class="inline-callout"><p>少了一個你很想要的主題？這張生活地圖，可以一起畫。</p><a class="text-link" href="/aeust-life/feedback/">提個新點子 ↗</a></div></section></Layout>
