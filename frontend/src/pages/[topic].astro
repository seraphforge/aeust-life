---
import Layout from '../layouts/Layout.astro';
import ClubGuide from '../components/ClubGuide.astro';
import { topics } from '../data/topics';
export function getStaticPaths() { return topics.map(topic => ({ params: { topic: topic.slug }, props: { topic } })); }
const { topic } = Astro.props;
---
<Layout title={topic.name} description={topic.description}>{topic.slug === 'clubs' ? <ClubGuide /> : <><section class="shell page-intro"><a class="breadcrumb" href="/aeust-life/explore/">← 回到探索</a><p class="eyebrow">{topic.number} / {topic.english}</p><h1>{topic.name}<span class={`heading-icon ${topic.color}`} aria-hidden="true">{topic.icon}</span></h1><p class="intro-description">{topic.title}</p><div class="tag-list">{topic.tags.map(tag => <span>{tag}</span>)}</div></section><section class="shell section compact"><div class="empty-state"><div class={`empty-symbol ${topic.color}`} aria-hidden="true">{topic.icon}</div><span class="status-pill planned">規劃中 · 尚未開放</span><h2>{topic.empty}</h2><p>{topic.detail}</p><a class="button primary" href="/aeust-life/feedback/">我想提供建議 ↗</a><a class="text-link" href="/aeust-life/roadmap/">看看開發進度 →</a></div>{topic.slug === 'hangouts' && <aside class="safety-note"><h2>一起出門，也要一起顧好安全。</h2><p>未來的揪團頁會提供公開場所見面提醒、個資保護提示與每則內容的檢舉入口。目前尚無發文或私訊功能；遇到即時危險時，請優先聯絡當地緊急服務。</p></aside>}{topic.slug === 'marketplace' && <aside class="safety-note"><h2>先建立信任，再開始交流。</h2><p>目前請勿透過回饋表單張貼交易或付款資訊。平台未提供金流、保證交易或第三方託管服務。</p></aside>}</section></>}</Layout>
